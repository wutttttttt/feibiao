<view class="page">
  <view class="title">异常货与货损</view><view wx:if="{{error}}" class="error">{{error}}</view>
  <view wx:if="{{!selected}}">
    <view class="notice">责任确认只留记录，不自动向客户或货主扣款。</view>
    <view wx:for="{{damages}}" wx:key="id" class="card row" data-id="{{item.id}}" bindtap="open"><view class="grow"><view class="strong">{{item.good.code}} · {{item.good.name}}</view><view class="muted">{{item.description}}</view></view><view>{{item.state}} ›</view></view>
    <view wx:if="{{damages.length === 0}}" class="empty">暂无异常货记录</view>
  </view>
  <view wx:else class="card">
    <view class="section">{{selected.good.code}} · {{selected.good.name}}</view>
    <view class="notice">发现情况：{{selected.description}}</view>
    <image wx:if="{{photo}}" src="{{photo}}" mode="aspectFill" style="width:100%;height:420rpx;border-radius:18rpx" />
    <view wx:if="{{selected.resolvedAt}}" class="muted">已结案：{{selected.resolution}}</view>
    <view wx:elif="{{canReview}}">
      <view class="field">责任归属<picker class="picker" range="{{responsibilityChoices}}" bindchange="responsibility">{{responsibilityChoices[responsibilityIndex]}}</picker></view>
      <view class="field">处置结果<picker class="picker" range="{{dispositionChoices}}" bindchange="disposition">{{dispositionChoices[dispositionIndex]}}</picker></view>
      <button class="button secondary" disabled="{{busy}}" bindtap="attachPhoto">拍摄或选择凭证照片</button>
      <view class="field">复核说明<input class="input" value="{{reason}}" bindinput="editReason" placeholder="描述检查结果和处置依据" /></view>
      <button class="button" disabled="{{busy}}" loading="{{busy}}" bindtap="save">记录老板复核</button>
    </view>
    <view wx:else class="muted">请老板复核并处置。</view>
    <button class="button secondary" bindtap="back">返回</button>
  </view>
</view>
