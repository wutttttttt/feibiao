page{background:#f4f7f5;color:#173a30;font-size:30rpx}.page{padding:24rpx 24rpx 56rpx}.title{font-size:42rpx;font-weight:700;margin:16rpx 0 24rpx}.sub{color:#71847a;font-size:25rpx;margin:8rpx 0 20rpx}.card{background:#fff;border:1rpx solid #dae7df;border-radius:22rpx;padding:26rpx;margin:16rpx 0}.row{display:flex;align-items:center;justify-content:space-between;gap:14rpx}.wrap{flex-wrap:wrap}.grow{flex:1;min-width:0}.strong{font-weight:700}.muted{color:#6a8074;font-size:26rpx}.money{font-size:36rpx;color:#0b6a4e;font-weight:700}.button{background:#086d52;color:white;border-radius:14rpx;font-size:29rpx;margin:14rpx 0;padding:4rpx 18rpx}.button::after{border:0}.button.secondary{background:#eaf4ee;color:#0a6249}.button.warn{background:#fff0e9;color:#a2452e}.button.small{font-size:25rpx;padding:0 16rpx;margin:5rpx}.field{display:block;margin:20rpx 0;color:#476157;font-size:27rpx}.input,.picker{display:block;background:white;border:1rpx solid #c8dad0;border-radius:12rpx;padding:18rpx;margin-top:8rpx;min-height:42rpx;color:#183d32}.picker{min-height:44rpx}.search{background:white;border:1rpx solid #c8dad0;border-radius:12rpx;padding:17rpx;margin:12rpx 0}.pill{display:inline-block;padding:10rpx 20rpx;margin:5rpx;background:#e8f3ec;border-radius:40rpx;color:#21634e;font-size:26rpx}.pill.selected{background:#086d52;color:white}.notice{background:#e8f5eb;border-radius:14rpx;padding:17rpx;color:#0c6548;margin:14rpx 0}.error{background:#fff0e9;color:#ad402c;border-radius:14rpx;padding:17rpx;margin:14rpx 0}.divider{height:1rpx;background:#e4eee7;margin:18rpx 0}.thumb{width:110rpx;height:110rpx;border-radius:14rpx;background:#e7f1e9;margin-right:15rpx;flex:none}.section{font-size:33rpx;font-weight:700;margin:34rpx 0 15rpx}.empty{color:#81958a;text-align:center;padding:50rpx}.two{display:flex;gap:12rpx}.two .button{flex:1}.stat{width:48%;box-sizing:border-box}.stat .money{font-size:37rpx}.code{font-family:monospace;font-size:28rpx}
